# Neon Postgres — https://console.neon.tech (free tier is enough)
# Project → Connection string → "Pooled connection"
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Admin dashboard at /admin
ADMIN_PASSWORD="choose-a-long-password"
# Any long random string. Generate one with:  openssl rand -base64 32
ADMIN_SESSION_SECRET="replace-with-a-random-32-byte-string"
